{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NanbudoTV·AI：桌面端（带窗口）",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "args": []
    },
    {
      "name": "NanbudoTV·AI：仅内核（无窗口，调试接口用）",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "args": ["--no-gui", "--port", "0"]
    },
    {
      "name": "NanbudoTV·AI：单元测试",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "args": ["discover", "-s", "tests"]
    }
  ]
}
